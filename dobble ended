#include <stdio.h>
#include <stdlib.h>
#define MAX 5

int deque[MAX];
int left = -1, right = -1;

void insert_right(int value)
{
    if ((left == 0 && right == MAX - 1) || (left == right + 1))
    {
        printf("\nOVERFLOW - Deque is full\n");
        return;
    }
    if (left == -1)
    {
        left = 0;
        right = 0;
    }
    else if (right == MAX - 1)
        right = 0;
    else
        right++;
    deque[right] = value;
    printf("\nInserted %d at right\n", value);
}

void insert_left(int value)
{
    if ((left == 0 && right == MAX - 1) || (left == right + 1))
    {
        printf("\nOVERFLOW - Deque is full\n");
        return;
    }
    if (left == -1)
    {
        left = 0;
        right = 0;
    }
    else if (left == 0)
        left = MAX - 1;
    else
        left--;
    deque[left] = value;
    printf("\nInserted %d at left\n", value);
}

void delete_left()
{
    if (left == -1)
    {
        printf("\nUNDERFLOW - Deque is empty\n");
        return;
    }
    printf("\nDeleted element from left: %d\n", deque[left]);
    if (left == right)
    {
        left = -1;
        right = -1;
    }
    else if (left == MAX - 1)
        left = 0;
    else
        left++;
}

void delete_right()
{
    if (right == -1)
    {
        printf("\nUNDERFLOW - Deque is empty\n");
        return;
    }
    printf("\nDeleted element from right: %d\n", deque[right]);
    if (left == right)
    {
        left = -1;
        right = -1;
    }
    else if (right == 0)
        right = MAX - 1;
    else
        right--;
}

void display()
{
    int i;
    if (left == -1)
    {
        printf("\nDeque is empty\n");
        return;
    }
    printf("\nDeque elements: ");
    i = left;
    while (1)
    {
        printf("%d ", deque[i]);
        if (i == right)
            break;
        i = (i + 1) % MAX;
    }
    printf("\n");
}

int main()
{
    int choice, value;
    while (1)
    {
        printf("\n----- DOUBLE ENDED CIRCULAR QUEUE -----");
        printf("\n1. Insert at right");
        printf("\n2. Insert at left");
        printf("\n3. Delete from left");
        printf("\n4. Delete from right");
        printf("\n5. Display");
        printf("\n6. Exit");
        printf("\nEnter your choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
        case 1:
            printf("Enter value to insert at right: ");
            scanf("%d", &value);
            insert_right(value);
            break;
        case 2:
            printf("Enter value to insert at left: ");
            scanf("%d", &value);
            insert_left(value);
            break;
        case 3:
            delete_left();
            break;
        case 4:
            delete_right();
            break;
        case 5:
            display();
            break;
        case 6:
            exit(0);
        default:
            printf("\nInvalid choice. Try again.\n");
        }
    }
    return 0;
}
